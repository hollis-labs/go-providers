== claude-print
provider=claude mode=subprocess-per-turn
file .claude/settings.json mode=0000 role=native-config sha=ca3d163bab05
file .mcp.json mode=0600 role=mcp sha=47d93eee06b4
file CLAUDE.md mode=0000 role=instructions sha=0d94bbadf34b
file boot.md mode=0000 role=boot sha=da91b953f821
launch {"executable":"claude","mode":"subprocess-per-turn","cwd":"boot","config_root":"boot","argv":[{"kind":"resume","value":"--resume"},{"kind":"literal","value":"-p"},{"kind":"literal","value":"--output-format"},{"kind":"literal","value":"stream-json"},{"kind":"literal","value":"--verbose"},{"kind":"file","value":"--mcp-config","root":"boot","rel_path":".mcp.json","omit_empty":true},{"kind":"system-prompt","value":"--system-prompt=","first_turn_only":true},{"kind":"extra"},{"kind":"root","value":"--add-dir","root":"project","omit_empty":true},{"kind":"prompt"}],"env":null}
effects [{"kind":"claude-credential-helper","destination":".claude/settings.json","reason":"apiKeyHelper may execute at runtime; projection only serializes the configured path"},{"kind":"claude-workspace-trust","reason":"workspace trust seeding mutates host state and is handled by explicit preparation"}]
binding {"cwd":"/p/boot","config_dir":"/p/boot","argv":["-p","--output-format","stream-json","--verbose","--mcp-config","/p/boot/.mcp.json","--add-dir","/p/project","--","PROMPT"],"env":[]}
legacy-file CLAUDE.md mode=0000
legacy-file boot.md mode=0000
legacy-file .claude/settings.json mode=0000
legacy-file .mcp.json mode=0000
legacy-env [] cwd=0 project-arg="--add-dir {{.ProjectDir}}"
